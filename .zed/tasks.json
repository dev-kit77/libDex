// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "libDex: Run System",
    "command": "g++ ./lib/*.cpp ./src/*.cpp ./src/data/*.cpp -o ./bin/libdex.out -I./lib -I./src -I./src/data && ./bin/libdex.out",
    "use_new_terminal": false,
    "reveal": "always"
  },

  {
    "label": "libDex: Compile System",
    "command": "g++ -g ./lib/*.cpp ./src/*.cpp ./src/data/*.cpp -o ./bin/libdex.out -I./lib -I./src -I./src/data",
    "use_new_terminal": false,
    "reveal": "always"
  },

  {
    "label": "libDex: Compile Interface Tests",
    "command": "g++ -g ./lib/interface.cpp ./tests/iftest.cpp -o ./bin/interfaceTests.out -I./lib",
    "use_new_terminal": false,
    "reveal": "always"
  },

  {
    "label": "libDex: Compile Library Tests",
    "command": "g++ -g ./lib/*.cpp ./src/*.cpp ./src/data/*.cpp ./tests/libtest.cpp -o ./bin/libraryTests.out -I./lib -I./src -I./src/data",
    "use_new_terminal": false,
    "reveal": "always"
  },

  {
    "label": "libDex: Compile List Tests",
    "command": "g++ -g ./lib/*.cpp ./src/*.cpp ./src/data/*.cpp ./tests/listtest.cpp -o ./bin/listTests.out -I./lib -I./src -I./src/data",
    "use_new_terminal": false,
    "reveal": "always"
  },

  {
    "label": "libDex: Compile Publication Tests",
    "command": "g++ -g ./lib/*.cpp ./src/*.cpp ./src/data/*.cpp ./tests/pubtest.cpp -o ./bin/publicationTests.out -I./lib -I./src -I./src/data",
    "use_new_terminal": false,
    "reveal": "always"
  },

  {
    "label": "libDex: Compile Utility Tests",
    "command": "g++ -g ./lib/*.cpp ./tests/utiltest.cpp -o ./bin/utilitytests.out -I./lib -I./src -I./src/data",
    "use_new_terminal": false,
    "reveal": "always"
  },

  {
    "label": "libDex: Compile Scenario",
    "command": "g++ -g ./lib/*.cpp ./src/*.cpp ./src/data/*.cpp ./tests/scenario.cpp -o ./bin/scenario.out -I./lib -I./src -I./src/data",
    "use_new_terminal": false,
